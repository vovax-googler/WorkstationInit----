# Copy this file to `.env` and edit the values, then run `bash deploy.sh`.
# `.env` is git-ignored so your project-specific values are never committed.
#
# The comments show reference values from a known-good deployment as an
# example — replace them with your own.

# --- Required: identifiers ---------------------------------------------------
PROJECT_ID=your-project-id                     # e.g. my-gcp-project
REGION=europe-west3                            # region of the Workstations cluster
CLUSTER=cluster-workstations                   # existing Workstations cluster name
CONFIG=ws-ai-default                           # workstation config to create
WORKSTATION=ws-default                         # workstation instance to create

# GCS bucket that will host startup.sh (must be readable by the workstation
# service account). Created automatically by deploy.sh if it does not exist.
BUCKET=gs://your-bucket-workstation-startup

# --- Networking (used by bootstrap.sh on a clean project) --------------------
# A VPC + subnet are required. The subnet gets Private Google Access, and a
# Cloud Router + Cloud NAT give the private (no-public-IP) VM outbound internet
# so startup.sh can apt-get/curl the tools. bootstrap.sh creates all of these.
NETWORK=ws-network
SUBNET=ws-subnet
SUBNET_RANGE=10.10.0.0/24
ROUTER=ws-router
NAT=ws-nat

# Keep the VM off the public internet (recommended). When true, Cloud NAT
# (created by bootstrap.sh) is what makes the in-VM installs work.
DISABLE_PUBLIC_IP=true

# --- VM / instance sizing ----------------------------------------------------
MACHINE_TYPE=e2-standard-4
BOOT_DISK_GB=50

# --- Persistent home disk ----------------------------------------------------
PD_DISK_GB=50
PD_DISK_TYPE=pd-ssd                            # pd-standard | pd-balanced | pd-ssd

# --- Pooling & timeouts ------------------------------------------------------
POOL_SIZE=1                                    # warm instances for fast startup (0 to disable)
IDLE_TIMEOUT=7200                              # seconds of inactivity before stop
RUNNING_TIMEOUT=43200                          # max run time in seconds

# High-availability replica zones for the persistent disk (comma-separated).
REPLICA_ZONES=europe-west3-a,europe-west3-b

# --- Identity ----------------------------------------------------------------
# Leave blank to use the project's default Compute Engine service account
# (deploy.sh resolves it as <PROJECT_NUMBER>-compute@developer.gserviceaccount.com).
SERVICE_ACCOUNT=

# --- Inside-the-container user ----------------------------------------------
# Default user in the predefined code-oss image; its home (/home/$WS_USER) is
# the persistent disk where per-user CLIs are installed.
WS_USER=user
